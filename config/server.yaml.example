# Example configuration for the zero-trust-proxy server.

listen:
  http: ":80"
  https: ":443"
  # Optional QUIC/HTTP3 listener. Same TLS config as :443; uses UDP.
  # http3: ":443"
  # 308 redirect for HTTP, with /.well-known/acme-challenge/* bypass
  # automatically mounted when tls.mode == acme.
  http_redirect: true

tls:
  mode: acme            # manual | sni | acme | none

  # On-demand TLS via Let's Encrypt. Cert issuance is gated by the
  # agent registry — only domains with an active service registered
  # over mTLS will be issued certs.
  acme:
    storage_dir: /config/acme
    email: ops@example.com
    # ca_url: ""        # optional override (e.g. staging directory URL)

  # Alternative modes (mutually exclusive):
  #
  # mode: manual
  # manual:
  #   cert_file: /etc/certs/server.crt
  #   key_file:  /etc/certs/server.key
  #
  # mode: sni
  # sni:
  #   "service.example.com":
  #     cert_file: /etc/certs/service.crt
  #     key_file:  /etc/certs/service.key
  #   "other.example.com":
  #     cert_file: /etc/certs/other.crt
  #     key_file:  /etc/certs/other.key

agents:
  listen:    ":8443"
  cert_file: /config/certs/server.crt
  key_file:  /config/certs/server.key
  ca_file:   /config/certs/ca.crt
  # Optional legacy "ask" endpoint for external tooling. The in-process
  # ACME HostPolicy already consults the registry directly; you only
  # need this if something outside the proxy queries domain liveness.
  check_addr: ":2020"
  # Optional port range for TCP-service listeners (services with
  # protocol: tcp get a public port allocated from this range).
  # tcp_port_min: 20000
  # tcp_port_max: 30000

  # Agent identity binding (see docs/server/agent-identity.md).
  # cn   — register ID must equal the client-cert Subject CommonName
  # san  — register ID must equal the first DNS SAN
  # none — legacy, unverified (default); mismatches are still counted
  #        in ztp_agent_identity_mismatch_total so you can observe
  #        before flipping to cn.
  identity:
    bind_to: none

  # Per-agent hostname allow-list. Label-aware globs: "*" matches
  # exactly one DNS label ("*.eu.example.com" matches a.eu.example.com,
  # NOT eu.example.com or a.b.eu.example.com). Agents absent from the
  # list are rejected at register time unless allow_unlisted: true.
  acl:
    allow_unlisted: true
    # agents:
    #   - id: "synology"
    #     allowed_hosts: ["*.local.example.com"]
    #   - id: "edge-eu"
    #     allowed_hosts: ["*.eu.example.com", "status.example.com"]

  # Client-certificate revocation, checked at the TLS handshake.
  # crl_file is re-read on SIGHUP.
  revocation: {}
    # crl_file: /config/certs/revoked.crl
    # denied_serials: ["0A1B2C3D"]

router:
  request_timeout: 2m

logging:
  level: info        # debug | info | warn | error
  format: console    # console | json
  access_log: false  # per-request JSON access logs

# Optional Prometheus exporter at /metrics. Bind to a private interface
# — there is no auth on this endpoint.
metrics:
  addr: ""           # e.g. "127.0.0.1:9100"

# Edge security: pre-dispatch firewall + rate limiting. Both are
# enforced before a request reaches any agent, and complement the
# per-service route policies (ip_whitelist / rate_limit) that agents
# enforce in their own service configs. Rules and limits hot-reload on
# SIGHUP; flipping an `enabled` flag requires a restart.
security:
  rate_limit:
    enabled: false
    default:
      key: ip            # ip | host | ip+host (bucket key)
      rate: 100/s        # <n>/<s|m|h>
      burst: 200         # 0 = default to the rate count
    overrides:           # first hostname match wins
      - hosts: ["api.example.com"]
        key: ip
        rate: 20/s
        burst: 40
  firewall:
    enabled: false
    max_request_bytes: 33554432   # 32 MiB; 0 = unlimited
    rules:                        # ordered; first match wins; no match = allow
      - name: block-secret-probes
        action: deny
        when:
          paths: ["/.env", "/.git/*", "/wp-admin/*"]
      - name: office-only-admin
        action: allow
        when:
          hosts: ["admin.example.com"]
          source_cidrs: ["203.0.113.0/24"]
      - name: deny-other-admin
        action: deny
        when:
          hosts: ["admin.example.com"]

# Identity-based access policy — evaluated on every request before it
# is dispatched to an agent (see docs/server/access-policy.md).
# Secrets are env-referenced, never inline. rules/service_tokens
# hot-reload on SIGHUP; enabled/session/identity_providers are
# restart-only.
access:
  enabled: false
  # session:
  #   secret: "${ZTP_SESSION_SECRET}"   # env-expanded; >= 32 bytes
  # email_otp:                         # one-time-code login (docs/server/access-policy.md)
  #   enabled: true
  #   from: "auth@example.com"
  #   smtp: { host: smtp.example.com, username: auth, password: "${ZTP_SMTP_PASSWORD}" }
  #   # brevo: { api_key: "${ZTP_BREVO_API_KEY}" }   # alternative sender
  #   ttl: 8h
  # service_tokens:
  #   - name: ci-deploy
  #     hash: "sha256:<64 hex of sha256(token)>"
  #     groups: ["ci"]
  # default_action: deny               # no rule matched -> deny
  # rules:
  #   - name: public-www
  #     when: { hosts: ["www.example.com"] }
  #     action: allow
  #   - name: ci-uploads
  #     when: { hosts: ["api.example.com"], paths: ["/upload/*"] }
  #     action: allow
  #     require: { groups: ["ci"] }
