# Example configuration for the zero-trust-proxy server.

listen:
  http: ":80"
  https: ":443"
  # Optional QUIC/HTTP3 listener. Same TLS config as :443; uses UDP.
  # http3: ":443"
  # 308 redirect for HTTP, with /.well-known/acme-challenge/* bypass
  # automatically mounted when tls.mode == acme.
  http_redirect: true

tls:
  mode: acme            # manual | sni | acme | none

  # On-demand TLS via Let's Encrypt. Cert issuance is gated by the
  # agent registry — only domains with an active service registered
  # over mTLS will be issued certs.
  acme:
    storage_dir: /config/acme
    email: ops@example.com
    # ca_url: ""        # optional override (e.g. staging directory URL)

  # Alternative modes (mutually exclusive):
  #
  # mode: manual
  # manual:
  #   cert_file: /etc/certs/server.crt
  #   key_file:  /etc/certs/server.key
  #
  # mode: sni
  # sni:
  #   "service.example.com":
  #     cert_file: /etc/certs/service.crt
  #     key_file:  /etc/certs/service.key
  #   "other.example.com":
  #     cert_file: /etc/certs/other.crt
  #     key_file:  /etc/certs/other.key

agents:
  listen:    ":8443"
  cert_file: /config/certs/server.crt
  key_file:  /config/certs/server.key
  ca_file:   /config/certs/ca.crt
  # Optional legacy "ask" endpoint for external tooling. The in-process
  # ACME HostPolicy already consults the registry directly; you only
  # need this if something outside the proxy queries domain liveness.
  check_addr: ":2020"
  # Optional port range for TCP-service listeners (services with
  # protocol: tcp get a public port allocated from this range).
  # tcp_port_min: 20000
  # tcp_port_max: 30000

router:
  request_timeout: 2m

logging:
  level: info        # debug | info | warn | error
  format: console    # console | json
  access_log: false  # per-request JSON access logs

# Optional Prometheus exporter at /metrics. Bind to a private interface
# — there is no auth on this endpoint.
metrics:
  addr: ""           # e.g. "127.0.0.1:9100"

# Edge security: pre-dispatch firewall + rate limiting. Both are
# enforced before a request reaches any agent, and complement the
# per-service route policies (ip_whitelist / rate_limit) that agents
# enforce in their own service configs. Rules and limits hot-reload on
# SIGHUP; flipping an `enabled` flag requires a restart.
security:
  rate_limit:
    enabled: false
    default:
      key: ip            # ip | host | ip+host (bucket key)
      rate: 100/s        # <n>/<s|m|h>
      burst: 200         # 0 = default to the rate count
    overrides:           # first hostname match wins
      - hosts: ["api.example.com"]
        key: ip
        rate: 20/s
        burst: 40
  firewall:
    enabled: false
    max_request_bytes: 33554432   # 32 MiB; 0 = unlimited
    rules:                        # ordered; first match wins; no match = allow
      - name: block-secret-probes
        action: deny
        when:
          paths: ["/.env", "/.git/*", "/wp-admin/*"]
      - name: office-only-admin
        action: allow
        when:
          hosts: ["admin.example.com"]
          source_cidrs: ["203.0.113.0/24"]
      - name: deny-other-admin
        action: deny
        when:
          hosts: ["admin.example.com"]
